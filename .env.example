# mock | firebase (defaults to mock; never silently falls back on Firebase errors)
VITE_DATA_BACKEND=mock
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# true connects BOTH Auth and Firestore to local emulators. No production access.
VITE_USE_EMULATOR=true
# Compatibility alias from PR #19. If either flag is true, use emulators.
VITE_USE_FIREBASE_EMULATORS=
VITE_FIREBASE_AUTH_EMULATOR_URL=
VITE_FIRESTORE_EMULATOR_HOST=
VITE_FIRESTORE_EMULATOR_PORT=8080
