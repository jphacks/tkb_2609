# このファイルをコピーして .env.local を作り、値を入れる（.env.local はコミットしない）
#   cp .env.example .env.local
#
# Firebase の Web アプリ設定（Firebase コンソール → プロジェクトの設定 → マイアプリ → SDK の設定と構成）。
# これらは公開前提の値で秘密情報ではないが、運用をそろえるため環境変数から読み込む。
# エミュレータだけで開発するときは空のままでよい。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true にすると、ローカルの Firebase エミュレータ（npm run emulators）に接続する。
# 本番のデータには一切触れないので、開発中は true を推奨。
VITE_USE_EMULATOR=true
