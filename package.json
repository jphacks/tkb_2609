{
  "name": "bukatsu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hosting": "VITE_DATA_BACKEND=firebase VITE_USE_EMULATOR=false npm run build",
    "deploy:hosting": "firebase deploy --only hosting --project prod",
    "lint": "oxlint",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-bukatsu --only auth,firestore --import=.emulator-data --export-on-exit",
    "test": "firebase emulators:exec --only auth,firestore --project demo-bukatsu \"vitest run\"",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "scale:seed": "node scripts/seed-scale.ts",
    "scale:check": "firebase emulators:exec --config firebase.scale.json --only auth,firestore --project demo-bukatsu-scale --export-on-exit .scale-artifacts/emulator \"BUKATSU_SCALE_CHECK=1 vitest run tests/scale.test.ts tests/scale-limits.test.ts --testTimeout=900000 --hookTimeout=900000\""
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
